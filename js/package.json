{
  "name": "zelf-sdk",
  "version": "1.3.1",
  "description": "Official TypeScript client for the Zelf API.",
  "license": "Apache-2.0",
  "author": "Zelf",
  "homepage": "https://github.com/hellozelf/zelf-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellozelf/zelf-sdk.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/hellozelf/zelf-sdk/issues"
  },
  "keywords": [
    "zelf",
    "api",
    "sdk",
    "social",
    "analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "openapi-typescript": "^7.13.0"
  }
}
