<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the LTS most consumers are on; net10.0 is current. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Zelf.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Zelf</Authors>
    <Description>.NET client for the ZelfAI APIs</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hellozelf/zelf-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hellozelf/zelf-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>zelf;api;sdk;social;analytics</PackageTags>
  </PropertyGroup>

</Project>
